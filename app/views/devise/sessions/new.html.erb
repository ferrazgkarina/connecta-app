<div class="auth-page d-flex flex-column align-items-center justify-content-center min-vh-100 px-3">
  <div class="w-100" style="max-width: 360px">

    <div class="text-center mb-4">
      <h1 class="brand-name mb-1" style="font-size: 2rem">connecta</h1>
      <p class="text-muted small">Bem-vinda de volta!</p>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= f.input :email,
                  label: false,
                  placeholder: "Email",
                  required: false,
                  autofocus: true,
                  input_html: { autocomplete: "email", class: "form-control mb-2" } %>
      <%= f.input :password,
                  label: false,
                  placeholder: "Senha",
                  required: false,
                  input_html: { autocomplete: "current-password", class: "form-control mb-3" } %>
      <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>

      <%= f.button :submit, "Entrar", class: "btn btn-dark w-100" %>
    <% end %>

    <p class="text-center text-muted small mt-3">
      <%= link_to "Esqueci minha senha", new_user_password_path, class: "text-muted" %>
    </p>

    <p class="text-center text-muted small mt-2">
      Ainda não tem conta? <%= link_to "Criar conta", new_user_registration_path, class: "text-dark fw-bold" %>
    </p>
  </div>
</div>
