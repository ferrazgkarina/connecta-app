<div class="auth-page d-flex flex-column align-items-center justify-content-center min-vh-100 px-3">
  <div class="w-100" style="max-width: 360px">

    <div class="text-center mb-4">
      <h1 class="brand-name mb-1" style="font-size: 2rem">connecta</h1>
      <p class="text-muted small">Crie sua conta para começar</p>
    </div>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <div data-controller="email-check">
        <%= f.input :email,
                    label: false,
                    placeholder: "Email",
                    required: true,
                    autofocus: true,
                    input_html: {
                      autocomplete: "email",
                      class: "form-control mb-1",
                      data: {
                        email_check_target: "input",
                        action: "input->email-check#check"
                      }
                    } %>
        <p data-email-check-target="feedback" class="mb-2" style="font-size: 0.8rem"></p>
      </div>

      <%= f.input :password,
                  label: false,
                  placeholder: "Senha",
                  required: true,
                  hint: false,
                  input_html: { autocomplete: "new-password", class: "form-control mb-2" } %>
      <%= f.input :password_confirmation,
                  label: false,
                  placeholder: "Confirme sua senha",
                  required: true,
                  input_html: { autocomplete: "new-password", class: "form-control mb-3" } %>

      <%= f.button :submit, "Criar conta", class: "btn btn-dark w-100" %>
    <% end %>

    <p class="text-center text-muted small mt-4">
      Já tem conta? <%= link_to "Entre aqui", new_user_session_path, class: "text-dark fw-bold" %>
    </p>
  </div>
</div>
