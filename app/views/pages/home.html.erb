<% if !user_signed_in? %>
<div class="auth-page d-flex flex-column align-items-center justify-content-center min-vh-100 px-3 text-center">
  <div class="w-100" style="max-width: 360px">
    <h1 class="brand-name mb-2" style="font-size: 2.2rem">connecta</h1>
    <p class="mb-1" style="font-size: 1.05rem">Nunca mais deixe de viver algo incrível por falta de companhia.</p>
    <p class="text-muted small mb-5">Disponível em: Rio de Janeiro, São Paulo e Belo Horizonte</p>
    <%= link_to "Criar conta", new_user_registration_path, class: "btn btn-dark w-100 mb-2" %>
    <%= link_to "Entrar", new_user_session_path, class: "btn btn-outline-dark w-100 mb-5" %>
    <%= link_to "Tem interesse em outras cidades?", new_city_interest_path, class: "text-muted small d-block mb-2" %>
    <%= link_to "Saiba mais sobre o connecta", about_path, class: "text-muted small" %>
  </div>
</div>
<% else %>

<div class="container py-4 pb-5" style="max-width: 400px;">

  <%# Header %>
  <div class="text-center mb-4">
    <h1 class="brand-name mb-0" style="font-size: 2rem">connecta</h1>
    <p class="text-muted small mb-0">Bem vinda de volta, <%= current_user.profile&.name || current_user.profile&.username %>!</p>
  </div>

  <% if user_signed_in? %>
    <% both_empty = @next_events.empty? && @new_city_events.empty? %>

    <% if both_empty %>
      <%# Estado vazio %>
      <div class="text-center py-4 mb-3">
        <p class="mb-2" style="font-size: 2rem">🧭</p>
        <p class="fw-bold mb-1">Nenhum encontro ainda</p>
        <p class="text-muted small mb-0">Explore o que está rolando na sua cidade ou crie o seu próprio encontro.</p>
      </div>
      <%= link_to events_path(city: current_user.profile&.location), class: "btn btn-dark w-100 mb-2" do %>
        <i class="fa-solid fa-compass me-1"></i> Descubra encontros em <%= current_user.profile&.location %>
      <% end %>
      <%= link_to new_event_path, class: "btn btn-outline-dark w-100 mb-4" do %>
        <i class="fa-solid fa-plus me-1"></i> Crie um encontro
      <% end %>
      <hr class="text-muted mb-3">
      <%= link_to edit_profile_path, class: "btn btn-link text-muted small text-decoration-none w-100 mb-1" do %>
        <i class="fa-solid fa-pen fa-xs me-1"></i> Editar perfil
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, class: "btn btn-link text-muted small w-100" do %>
        <i class="fa-solid fa-right-from-bracket me-1"></i> Sair da conta
      <% end %>
    <% else %>

      <%# Meus próximos encontros %>
      <div class="mb-4">
        <h2 class="fs-6 fw-bold mb-2">Meus próximos encontros</h2>
        <% if @next_events.any? %>
          <% @next_events.each do |event| %>
            <%= link_to event_path(event), class: "text-decoration-none text-dark" do %>
              <div class="d-flex align-items-center gap-3 border rounded-3 p-2 mb-2 bg-white">
                <div class="bg-dark text-white rounded-2 text-center p-1 flex-shrink-0" style="min-width: 38px; font-size: 0.65rem">
                  <div class="fw-bold" style="font-size: 0.9rem"><%= event.date.strftime("%d") %></div>
                  <div><%= I18n.l(event.date, format: "%b").upcase %></div>
                </div>
                <div>
                  <p class="fw-bold mb-0 small"><%= event.title %></p>
                  <p class="text-muted mb-0" style="font-size: 0.7rem"><%= event.city %> · <%= event.time.strftime("%H:%M") %></p>
                </div>
              </div>
            <% end %>
          <% end %>
          <%= link_to "Ver todos →", confirmed_events_path, class: "text-muted small" %>
        <% else %>
          <p class="text-muted small fst-italic">Você não tem encontros confirmados ainda.</p>
        <% end %>
      </div>

      <%# Novidades na cidade %>
      <div class="mb-4">
        <h2 class="fs-6 fw-bold mb-2">Novidades em <%= current_user.profile&.location %></h2>
        <% if @new_city_events.any? %>
          <% @new_city_events.each do |event| %>
            <%= link_to event_path(event), class: "text-decoration-none text-dark" do %>
              <div class="d-flex align-items-center gap-3 border rounded-3 p-2 mb-2 bg-white">
                <div class="bg-dark text-white rounded-2 text-center p-1 flex-shrink-0" style="min-width: 38px; font-size: 0.65rem">
                  <div class="fw-bold" style="font-size: 0.9rem"><%= event.date.strftime("%d") %></div>
                  <div><%= I18n.l(event.date, format: "%b").upcase %></div>
                </div>
                <div>
                  <p class="fw-bold mb-0 small"><%= event.title %></p>
                  <p class="text-muted mb-0" style="font-size: 0.7rem"><%= event.category %></p>
                </div>
              </div>
            <% end %>
          <% end %>
          <%= link_to "Ver todos →", events_path, class: "text-muted small" %>
        <% else %>
          <p class="text-muted small fst-italic">Nenhum encontro novo na sua cidade esta semana.</p>
        <% end %>
      </div>

    <% end %>

    <%# CTAs — só aparece quando há conteúdo %>
    <% if !both_empty %>
      <hr class="text-muted mb-3">
      <%= link_to events_path(city: current_user.profile&.location), class: "btn btn-dark w-100 mb-2" do %>
        <i class="fa-solid fa-compass me-1"></i> Descubra encontros em <%= current_user.profile&.location %>
      <% end %>
      <%= link_to new_event_path, class: "btn btn-outline-dark w-100 mb-3" do %>
        <i class="fa-solid fa-plus me-1"></i> Crie um encontro
      <% end %>
      <hr class="text-muted mb-3">
      <%= link_to edit_profile_path, class: "btn btn-link text-muted small text-decoration-none w-100 mb-1" do %>
        <i class="fa-solid fa-pen fa-xs me-1"></i> Editar perfil
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, class: "btn btn-link text-muted small w-100" do %>
        <i class="fa-solid fa-right-from-bracket me-1"></i> Sair da conta
      <% end %>
    <% end %>

  <% end %>
</div>

<% end %>

<% if user_signed_in? %>
  <%= render "shared/footer_nav" %>
<% end %>
